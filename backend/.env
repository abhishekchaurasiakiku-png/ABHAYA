# SafeHer-AI Backend Environment Variables
# Copy this file to .env and fill in the values.

# Server
PORT=3000
NODE_ENV=development

# Render (Your Live Deployment URL)
# Example: RENDER_EXTERNAL_URL=https://safeher-ai-backend.onrender.com
RENDER_EXTERNAL_URL=

# CORS Origin (If deploying a web frontend, paste your frontend URL here)
# Example: CORS_ORIGIN=https://my-flutter-app.web.app
CORS_ORIGIN=

# MongoDB Connection (Local or Atlas Cluster)
# To use MongoDB Atlas, replace the URI below with your cluster connection string:
# Example: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ABHAYA?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://tourism_org:zMU9iBrDtY.gf58@cluster0.jkfay0r.mongodb.net/ABHAYA?appName=Cluster0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
