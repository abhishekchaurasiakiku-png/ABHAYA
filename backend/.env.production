# SafeHer-AI Production Environment Variables
# Fill in these values in your cloud provider environment variables setting (e.g., Render, Heroku, AWS).

# Server
PORT=3000
NODE_ENV=production

# MongoDB (Use your MongoDB Atlas Connection URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/safeher-ai?retryWrites=true&w=majority
MONGODB_URI=your-mongodb-atlas-production-uri

# JWT (Use a cryptographically secure 256-bit key)
JWT_SECRET=your-production-secure-jwt-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Firebase (for FCM push notifications)
# Save your service account key file to the backend root directory (e.g. firebase-service-account.json)
# and reference it here, or set it as a config var pointing to the filename.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
